# ── Quorum configuration ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. `docker compose up -d` reads this file.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=quorum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quorum
# Must match the three values above. Host `postgres` is the compose service name.
DATABASE_URL=postgresql+psycopg://quorum:change-me@postgres:5432/quorum

# ── Discord (two separate applications / bot tokens) ─────────────────────────
DISCORD_TOKEN_SCHEDULER=
DISCORD_TOKEN_SCRIBE=
# Comma-separated guild ids for INSTANT slash-command sync while testing.
# Leave empty in production for global commands (up to ~1h to propagate).
DEV_GUILD_IDS=

# ── Transcription (Scribe) ───────────────────────────────────────────────────
# Provider: groq | openrouter | faster_whisper
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3
# Used only when TRANSCRIBE_PROVIDER=faster_whisper (also add the pip extra to the image).
FASTER_WHISPER_MODEL=distil-large-v3

# ── Minutes / summarisation (Scribe) ─────────────────────────────────────────
# Provider: deepseek | openrouter
MINUTES_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Scheduler behaviour ──────────────────────────────────────────────────────
# Minutes-before-start at which reminders fire (highest first).
REMINDER_OFFSETS=1440,60,10
DEFAULT_TIMEZONE=UTC
# Public URL where the iCal feed is reachable (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8080
ICAL_PORT=8080

# ── Scribe guardrails ────────────────────────────────────────────────────────
MAX_RECORDING_MINUTES=180
TRANSCRIBE_MAX_FILE_MB=24

# ── Google Calendar (optional) ───────────────────────────────────────────────
# Drop the service-account key at ./secrets/google-sa.json and uncomment:
# GOOGLE_SA_JSON=/secrets/google-sa.json
GOOGLE_SA_JSON=
